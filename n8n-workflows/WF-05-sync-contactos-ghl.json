      "main": [
        [{ "node": "😴 Sin contactos nuevos", "type": "main", "index": 0 }],
        [{ "node": "🔎 ¿Ya sincronizado?", "type": "main", "index": 0 }]
      ]
    },
    "🔎 ¿Ya sincronizado?": {
      "main": [[{ "node": "❓ ¿Ya en GHL?", "type": "main", "index": 0 }]]
    },
    "❓ ¿Ya en GHL?": {
      "main": [
        [{ "node": "⏭ Ya sincronizado", "type": "main", "index": 0 }],
        [{ "node": "➕ Crear Contacto en GHL", "type": "main", "index": 0 }]
      ]
    },
    "➕ Crear Contacto en GHL": {
      "main": [[{ "node": "💾 Guardar Sync en Supabase", "type": "main", "index": 0 }]]
    },
    "💾 Guardar Sync en Supabase": {
      "main": [[{ "node": "✅ Contacto sincronizado", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
