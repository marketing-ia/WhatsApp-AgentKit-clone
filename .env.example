# ============================================================
# AgentKit — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a GitHub.
# ============================================================

# ── Anthropic AI (requerido) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Proveedor de WhatsApp ───────────────────────────────────
# Opciones: chatwoot | meta | twilio
WHATSAPP_PROVIDER=chatwoot

# ── Si WHATSAPP_PROVIDER=chatwoot ──────────────────────────
CHATWOOT_URL=https://tu-chatwoot.dominio.com
CHATWOOT_API_TOKEN=...
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# ── Si WHATSAPP_PROVIDER=meta ───────────────────────────────
# META_ACCESS_TOKEN=...
# META_PHONE_NUMBER_ID=...
# META_VERIFY_TOKEN=agentkit-verify

# ── Si WHATSAPP_PROVIDER=twilio ─────────────────────────────
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Evolution API (para envío de documentos/PDF) ─────────────
EVOLUTION_API_URL=https://tu-evolution.dominio.com
EVOLUTION_API_KEY=...
EVOLUTION_INSTANCE=agentkit    # nombre de la instancia en Evolution

# ── Twilio Voice (para llamada de alerta al propietario) ──────
# Cuando un cliente pide hablar con una persona, Lucy llama al propietario via Twilio Voice.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX         # Número Twilio desde donde se llama
TWILIO_TRANSFER_NUMBER=+1XXXXXXXXXX     # Tu número — te llegará la alerta de voz

# ── Base de datos ────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/agentkit.db
# En producción (Railway/Easypanel + PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Servidor ─────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development    # development | production

# ── GHL — GoHighLevel (opcional, para sync de contactos y citas) ──
# GHL_API_KEY=pit-...
# GHL_LOCATION_ID=...

# ── n8n AgentKit (opcional, para workflows de automatización) ──
# N8N_WEBHOOK_URL=https://tu-n8n.dominio.com/webhook
