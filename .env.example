# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║         WHATSAPP AGENTKIT — VARIABLES DE ENTORNO                           ║
# ║  Copia este archivo: cp .env.example .env                                  ║
# ║  ⚠ = Obligatorio  |  ○ = Opcional (tiene default razonable)               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 1 — BASE DE DATOS (PostgreSQL compartido)
# ────────────────────────────────────────────────────────────────────────────

# ⚠ Contraseña maestra de PostgreSQL (la misma se reutiliza para todos los DB users)
# Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIA_ESTO_32_CHARS_MINIMO

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 2 — REDIS
# ────────────────────────────────────────────────────────────────────────────

# ⚠ Contraseña de Redis
# Genera con: openssl rand -hex 16
REDIS_PASSWORD=CAMBIA_ESTO_REDIS_PASSWORD

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 3 — SUPABASE
# ────────────────────────────────────────────────────────────────────────────

# ⚠ URL pública de tu Supabase (dominio que configuraste en Easypanel para Kong)
# Ejemplo: https://supabase.tudominio.com
SUPABASE_EXTERNAL_URL=https://supabase.tudominio.com

# ⚠ JWT Secret — DEBE tener al menos 32 caracteres
# Genera con: openssl rand -hex 32
SUPABASE_JWT_SECRET=CAMBIA_ESTO_JWT_SECRET_MINIMO_32_CHARS

# ⚠ ANON KEY — JWT firmado con SUPABASE_JWT_SECRET
# Genera con la herramienta online: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# O con: node -e "const jwt = require('jsonwebtoken'); console.log(jwt.sign({role:'anon',iss:'supabase',iat:1700000000,exp:9999999999},process.env.SUPABASE_JWT_SECRET))"
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR_CON_ANON_JWT

# ⚠ SERVICE ROLE KEY — JWT con permisos de admin (¡nunca exponer en frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR_CON_SERVICE_JWT

# ○ Credenciales del dashboard de Supabase Studio
SUPABASE_DASHBOARD_USER=supabase_admin
SUPABASE_DASHBOARD_PASS=CAMBIA_ESTO_DASHBOARD_PASS

# ⚠ Secret para Realtime
# Genera con: openssl rand -hex 32
REALTIME_SECRET=CAMBIA_ESTO_REALTIME_SECRET_32_CHARS

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 4 — EVOLUTION API (WhatsApp)
# ────────────────────────────────────────────────────────────────────────────

# ⚠ URL pública de Evolution API (dominio configurado en Easypanel)
EVOLUTION_SERVER_URL=https://evolution.tudominio.com

# ⚠ API Key de Evolution (la que uses para autenticar requests)
# Genera con: openssl rand -hex 20
EVOLUTION_API_KEY=CAMBIA_ESTO_EVOLUTION_API_KEY

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 5 — N8N (Orquestador)
# ────────────────────────────────────────────────────────────────────────────

# ⚠ Hostname de n8n (solo el dominio, sin https://)
N8N_HOST=n8n.tudominio.com

# ⚠ URL pública completa de n8n (para webhooks entrantes)
N8N_WEBHOOK_URL=https://n8n.tudominio.com

# ○ Credenciales de acceso al editor de n8n
N8N_USER=admin
N8N_PASSWORD=CAMBIA_ESTO_N8N_PASSWORD

# ⚠ Clave de encriptación para credenciales guardadas en n8n
# Genera con: openssl rand -hex 24
N8N_ENCRYPTION_KEY=CAMBIA_ESTO_N8N_ENCRYPTION_KEY

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 6 — CHATWOOT (Omnicanalidad)
# ────────────────────────────────────────────────────────────────────────────

# ⚠ URL pública de Chatwoot
CHATWOOT_EXTERNAL_URL=https://chat.tudominio.com

# ⚠ Secret key para Rails
# Genera con: openssl rand -hex 64
CHATWOOT_SECRET_KEY=CAMBIA_ESTO_CHATWOOT_SECRET_64_CHARS

# ⚠ API Token de Chatwoot (se obtiene después de crear cuenta en Chatwoot)
# Settings → Integrations → Access Token
CHATWOOT_API_TOKEN=OBTENER_DESPUES_DE_SETUP

# ○ ID de cuenta en Chatwoot (por defecto 1 si es fresh install)
CHATWOOT_ACCOUNT_ID=1

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 7 — EMAIL / SMTP
# ────────────────────────────────────────────────────────────────────────────

# ○ Configuración SMTP (para notificaciones de n8n, Chatwoot, Supabase Auth)
# Recomendado: Resend.com o SendGrid
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CAMBIA_ESTO_SMTP_API_KEY

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 8 — GHL (Go High Level) — CRM + Pipelines de ventas
# ────────────────────────────────────────────────────────────────────────────

# ⚠ API Key de GHL (encontrar en: Settings → Business Profile → API Keys)
GHL_API_KEY=CAMBIA_ESTO_GHL_API_KEY

# ⚠ Location IDs por vertical de negocio (encontrar en: Settings → Business Info)
# Clínicas médicas
GHL_LOCATION_CLINICA=CAMBIA_ESTO_LOCATION_ID_CLINICA

# Dentistas
GHL_LOCATION_DENTISTA=CAMBIA_ESTO_LOCATION_ID_DENTISTA

# Seguros (Roma Insurance Group, Lucy, Ysra, DL, etc.)
GHL_LOCATION_SEGUROS=CAMBIA_ESTO_LOCATION_ID_SEGUROS

# Realtor / Bienes raíces
GHL_LOCATION_REALTOR=CAMBIA_ESTO_LOCATION_ID_REALTOR

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 9 — TWILIO (Llamadas y transferencias)
# ────────────────────────────────────────────────────────────────────────────

# ⚠ Credenciales Twilio (console.twilio.com → Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CAMBIA_ESTO_TWILIO_AUTH_TOKEN

# ⚠ Número de Twilio desde el que se hacen llamadas (+E.164)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ○ Número de transferencia al agente humano (Roy / equipo)
TWILIO_TRANSFER_NUMBER=+1XXXXXXXXXX

# ○ Número de contacto a mostrar al cliente (en mensajes de texto)
TRANSFER_NUMBER_DISPLAY=+1 (XXX) XXX-XXXX

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 10 — ANTHROPIC (IA para Lucy)
# ────────────────────────────────────────────────────────────────────────────

# ⚠ API Key de Anthropic (platform.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-CAMBIA_ESTO

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 11 — OPENAI (Transcripción de notas de voz)
# ────────────────────────────────────────────────────────────────────────────

# ○ API Key de OpenAI — requerida para transcribir notas de voz (Whisper)
# Sin esta key, el agente ignorará los audios. Obtener en: platform.openai.com
OPENAI_API_KEY=sk-proj-CAMBIA_ESTO

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 12 — AGENTE LUCY / WHATSAPP (configuración del agente)
# ────────────────────────────────────────────────────────────────────────────

# ○ Nombre del agente (aparece en logs y health check)
AGENT_NAME=MiAgente

# ⚠ ID de tu calendario GHL (Settings → Calendars → copiar el ID)
GHL_CALENDAR_ID=TU_CALENDAR_ID_AQUI

# ⚠ Location ID principal de GHL para tu sub-cuenta
GHL_LOCATION_ID_PRINCIPAL=TU_LOCATION_ID_AQUI

# ○ URL de cotización o formulario de captura para el negocio
QUOTE_URL=https://tucotizacion.com

# ────────────────────────────────────────────────────────────────────────────
# SECCIÓN 13 — AGENTKIT LUCY (servidor del agente)
# ────────────────────────────────────────────────────────────────────────────

# ○ Puerto del servidor FastAPI
PORT=8000

# ○ Entorno (development | production)
ENVIRONMENT=production

# ⚠ URL y credenciales de Chatwoot para enviar mensajes
CHATWOOT_URL=https://chat.tudominio.com
CHATWOOT_API_TOKEN=OBTENER_DE_CHATWOOT_SETTINGS
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=TU_INBOX_ID

# ⚠ URL de la base de datos del agente (SQLite para desarrollo, volumen en producción)
DATABASE_URL=sqlite+aiosqlite:////app/data/agent.db

# ⚠ Evolution API (para envío de documentos PDF directamente vía WhatsApp)
EVOLUTION_API_URL=https://evolution.tudominio.com
EVOLUTION_API_KEY=TU_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=agentkit

# ⚠ Proveedor de WhatsApp (chatwoot | meta | twilio)
WHATSAPP_PROVIDER=chatwoot
